---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard from '../../components/VideoCard.astro';
import VideoModal from '../../components/VideoModal.astro';
import videosData from '../../data/videos.json';

export function getStaticPaths() {
  const { scholars, collections, videos } = videosData;
  // Speakers and the neutral bucket both get a page; only the bucket is
  // flagged so the page can leave the "scholar" wording out.
  const groups = [
    ...scholars.map((s) => ({ ...s, isCollection: false })),
    ...collections
      .filter((c) => c.videoCount > 0)
      .map((c) => ({ ...c, specialty: '', isCollection: true })),
  ];

  return groups.map((group) => ({
    params: { scholar: group.id },
    props: { group, videos: videos.filter((v) => v.scholarId === group.id) },
  }));
}

const { group, videos } = Astro.props;
---

<BaseLayout
  title={group.nameAr}
  titleTi={group.nameTi || 'ቪድዮታት'}
  description={`${videos.length} درساً مرئياً — ${group.nameAr}`}
>
  <!-- Header -->
  <section class="hero-gradient text-white py-14">
    <div class="container text-center">
      <a
        href="/videos"
        class="bg-white/20 hover:bg-white/30 text-white px-6 py-3 rounded-lg transition-colors inline-flex items-center gap-3 mb-8"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="flex flex-col items-start text-right">
          <span class="text-base font-semibold">العودة لقائمة العلماء</span>
          <span class="text-xs opacity-80">Back to Scholars | ናብ ዓሊማት ተመለሱ</span>
        </span>
      </a>

      <div class="trilingual-title items-center mb-4">
        <h1 class="ar text-3xl md:text-4xl font-bold text-white font-amiri">{group.nameAr}</h1>
        {group.nameTi && <p class="ti text-lg text-white/80 font-ethiopic">{group.nameTi}</p>}
      </div>
      {group.specialty && <p class="text-accent text-base mb-2">{group.specialty}</p>}
      <p class="text-lg opacity-90">
        <span class="font-bold">{videos.length}</span> فيديو | videos
      </p>
    </div>
  </section>

  <!-- Videos -->
  <section class="py-12 bg-cream">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {videos.map((video) => (
          <VideoCard
            slug={video.slug}
            youtubeId={video.youtubeId}
            titleAr={video.titleAr}
            titleTi={video.titleTi}
            scholarName={video.scholarName}
            seriesName={video.seriesName}
            duration={video.duration}
          />
        ))}
      </div>
    </div>
  </section>

  <VideoModal />
</BaseLayout>

<style>
  .font-amiri {
    font-family: var(--font-amiri);
  }
  .font-ethiopic {
    font-family: var(--font-ethiopic);
  }
</style>
