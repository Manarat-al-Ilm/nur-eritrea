---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QACardPreview from '../../components/QACardPreview.astro';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const PER_PAGE = 10;

const url = new URL(Astro.request.url);
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const sort = url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const searchQuery = (url.searchParams.get('q') ?? '').trim().slice(0, 200);

// Safe: orderBy only from hardcoded ternary, never from user input
const orderBy = sort === 'oldest' ? 'answered_at ASC' : 'answered_at DESC';
const hasSearch = searchQuery.length > 0;
const searchWhere = hasSearch
  ? " AND (question_text LIKE ?1 OR title LIKE ?1 OR answer_text LIKE ?1)"
  : '';
const searchParam = `%${searchQuery}%`;

const countSql = `SELECT COUNT(*) as total FROM questions WHERE status = 'answered'${searchWhere}`;
const { total } = (hasSearch
  ? await db.prepare(countSql).bind(searchParam).first<{ total: number }>()
  : await db.prepare(countSql).first<{ total: number }>()
) ?? { total: 0 };

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const currentPage = Math.min(page, totalPages);
const offset = (currentPage - 1) * PER_PAGE;

const dataSql = `SELECT id, question_text, title, answer_audio_key, answered_at
  FROM questions WHERE status = 'answered'${searchWhere}
  ORDER BY ${orderBy} LIMIT ? OFFSET ?`;
const { results } = hasSearch
  ? await db.prepare(dataSql).bind(searchParam, PER_PAGE, offset).all()
  : await db.prepare(dataSql).bind(PER_PAGE, offset).all();

// Cache answered Q&A list for 5 min, serve stale up to 1 hour while revalidating
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');

const questions: { id: number; title: string | null; question_text: string; has_audio: boolean; answered_at: string }[] = results.map((row: any) => ({
  id: row.id,
  title: row.title,
  question_text: row.question_text,
  has_audio: !!row.answer_audio_key,
  answered_at: row.answered_at,
}));

function buildQaUrl(pageNum: number): string {
  const params = new URLSearchParams();
  if (pageNum > 1) params.set('page', String(pageNum));
  if (sort !== 'newest') params.set('sort', sort);
  if (searchQuery) params.set('q', searchQuery);
  const qs = params.toString();
  return qs ? `/qa?${qs}` : '/qa';
}
---

<BaseLayout
  title="سؤال وجواب"
  titleTi="ሕቶን መልስን"
  description="اطرح سؤالك الشرعي واحصل على إجابة من العلماء"
>
  <!-- Hero -->
  <section class="hero-gradient text-white py-16">
    <div class="container text-center">
      <div class="trilingual-title items-center mb-6">
        <h1 class="ar text-4xl font-bold text-white font-amiri">سؤال وجواب</h1>
        <p class="en text-xl text-accent font-medium">Question & Answer</p>
        <p class="ti text-lg text-white/80 font-ethiopic">ሕቶን መልስን</p>
      </div>
      <p class="text-lg opacity-90 max-w-2xl mx-auto mb-2">
        اطرح سؤالك وسيجيب عليه أحد العلماء
      </p>
      <p class="text-base opacity-75 max-w-2xl mx-auto">
        Ask your question and a scholar will answer it
      </p>
    </div>
  </section>

  <!-- Question Form -->
  <section class="py-12 bg-cream">
    <div class="container max-w-2xl">
      <div class="card p-8">
        <h2 class="text-2xl font-bold text-text-dark mb-2 font-amiri">اطرح سؤالك</h2>
        <p class="text-sm text-text-light mb-6">Ask your question | ሕቶኹም ጸሓፉ</p>

        <form id="question-form">
          <div class="mb-4">
            <textarea
              id="question-input"
              name="question_text"
              rows="4"
              maxlength="1000"
              placeholder="اكتب سؤالك هنا..."
              class="w-full px-4 py-3 border border-cream-dark rounded-lg bg-white text-text-dark placeholder:text-text-light/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 resize-none"
              required
            ></textarea>
            <div class="flex justify-between items-center mt-1">
              <p id="form-message" class="text-sm hidden"></p>
              <p class="text-xs text-text-light">
                <span id="char-count">0</span>/1000
              </p>
            </div>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn btn-primary w-full flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span>إرسال السؤال</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Answered Questions -->
  <section class="py-16 bg-white">
    <div class="container max-w-3xl">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-text-dark mb-1 font-amiri">الأسئلة المجاب عنها</h2>
        <p class="text-primary font-medium mb-1">Answered Questions</p>
        <p class="text-text-light font-ethiopic">ዝተመለሱ ሕቶታት</p>
      </div>

      <!-- Search & Sort -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <form method="get" action="/qa" class="flex-1 flex gap-2">
          <input type="hidden" name="sort" value={sort} />
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="ابحث في الأسئلة... | Search..."
            maxlength="200"
            class="flex-1 px-4 py-2.5 border border-cream-dark rounded-lg bg-white text-text-dark placeholder:text-text-light/50 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm"
          />
          <button type="submit" class="btn btn-primary px-4 py-2.5 text-sm">
            بحث
          </button>
        </form>
        <select id="sort-select" class="px-3 py-2.5 text-sm border border-cream-dark rounded-lg bg-white text-text-dark focus:outline-none focus:border-primary">
          <option value="newest" selected={sort === 'newest'}>الأحدث أولاً</option>
          <option value="oldest" selected={sort === 'oldest'}>الأقدم أولاً</option>
        </select>
      </div>

      {searchQuery && (
        <div class="flex items-center gap-2 mb-4 text-sm text-text-light">
          <span>نتائج البحث عن &laquo;{searchQuery}&raquo;: {total}</span>
          <a href={sort !== 'newest' ? `/qa?sort=${sort}` : '/qa'} class="text-primary hover:underline">مسح البحث</a>
        </div>
      )}

      {questions.length > 0 ? (
        <div class="space-y-4">
          {questions.map((q) => (
            <QACardPreview {...q} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <div class="w-20 h-20 rounded-full bg-cream mx-auto mb-4 flex items-center justify-center">
            <svg class="w-10 h-10 text-text-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          {searchQuery ? (
            <p class="text-text-light text-lg">لا توجد نتائج</p>
          ) : (
            <>
              <p class="text-text-light text-lg">لا توجد أسئلة مجاب عنها بعد</p>
              <p class="text-text-light text-sm mt-1">No answered questions yet</p>
            </>
          )}
        </div>
      )}

      {totalPages > 1 && (
        <nav class="flex justify-center items-center gap-4 mt-10">
          {currentPage > 1 ? (
            <a href={buildQaUrl(currentPage - 1)} class="px-4 py-2 text-sm rounded-lg border border-cream-dark hover:bg-cream transition-colors">
              السابق
            </a>
          ) : (
            <span class="px-4 py-2 text-sm rounded-lg border border-cream-dark opacity-40 cursor-not-allowed">
              السابق
            </span>
          )}
          <span class="text-sm text-text-light">صفحة {currentPage} من {totalPages}</span>
          {currentPage < totalPages ? (
            <a href={buildQaUrl(currentPage + 1)} class="px-4 py-2 text-sm rounded-lg border border-cream-dark hover:bg-cream transition-colors">
              التالي
            </a>
          ) : (
            <span class="px-4 py-2 text-sm rounded-lg border border-cream-dark opacity-40 cursor-not-allowed">
              التالي
            </span>
          )}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Sort dropdown: navigate on change
  const sortSelect = document.getElementById('sort-select');
  sortSelect?.addEventListener('change', () => {
    const url = new URL(window.location.href);
    url.searchParams.set('sort', sortSelect.value);
    url.searchParams.delete('page');
    window.location.href = url.toString();
  });

  const form = document.getElementById('question-form');
  const input = document.getElementById('question-input');
  const charCount = document.getElementById('char-count');
  const formMessage = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn');

  input?.addEventListener('input', () => {
    if (charCount) charCount.textContent = input.value.length;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const text = input?.value?.trim();
    if (!text) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="animate-pulse">جاري الإرسال...</span>';

    try {
      const res = await fetch('/api/questions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question_text: text }),
      });

      const data = await res.json();

      if (res.ok) {
        formMessage.textContent = 'تم إرسال سؤالك بنجاح! سيتم الإجابة عليه قريباً إن شاء الله.';
        formMessage.className = 'text-sm text-green-600';
        formMessage.classList.remove('hidden');
        input.value = '';
        charCount.textContent = '0';
      } else {
        formMessage.textContent = data.error || 'حدث خطأ. حاول مرة أخرى.';
        formMessage.className = 'text-sm text-red-500';
        formMessage.classList.remove('hidden');
      }
    } catch {
      formMessage.textContent = 'حدث خطأ في الاتصال. حاول مرة أخرى.';
      formMessage.className = 'text-sm text-red-500';
      formMessage.classList.remove('hidden');
    }

    submitBtn.disabled = false;
    submitBtn.innerHTML = `
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
      </svg>
      <span>إرسال السؤال</span>
    `;
  });
</script>

<style>
  .font-amiri {
    font-family: var(--font-amiri);
  }
  .font-ethiopic {
    font-family: var(--font-ethiopic);
  }
</style>
