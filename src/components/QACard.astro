---
import { getDisplayTitle } from '../lib/auth';

interface Props {
  id: number;
  title: string | null;
  question_text: string;
  answer_text: string | null;
  answer_audio_url: string | null;
  answered_at: string;
}

const { id, title, question_text, answer_text, answer_audio_url, answered_at } = Astro.props;

const displayTitle = getDisplayTitle(title, question_text);
const formattedDate = new Date(answered_at).toLocaleDateString('ar-SA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="card p-6">
  <!-- Title -->
  <h2 class="text-xl font-bold text-text-dark font-amiri mb-4">{displayTitle}</h2>

  <!-- Question -->
  <div class="flex gap-3 mb-4">
    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div>
      <p class="text-sm text-primary font-medium mb-1">السؤال</p>
      <p class="text-text-dark font-semibold leading-relaxed">{question_text}</p>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-cream-dark my-4"></div>

  <!-- Answer -->
  <div class="flex gap-3">
    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center">
      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div class="flex-1">
      <p class="text-sm text-accent font-medium mb-1">الجواب</p>

      {answer_text && (
        <p class="text-text-dark leading-relaxed mb-3 whitespace-pre-wrap">{answer_text}</p>
      )}

      {answer_audio_url && (
        <div class="bg-cream rounded-lg p-3">
          <p class="text-xs text-text-light mb-2 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
            إجابة صوتية
          </p>
          <audio controls class="w-full" preload="none">
            <source src={answer_audio_url} />
          </audio>
        </div>
      )}

      <p class="text-xs text-text-light mt-3">{formattedDate}</p>
    </div>
  </div>
</div>
